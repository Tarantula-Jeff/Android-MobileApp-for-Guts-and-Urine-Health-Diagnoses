rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isDoctor() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor';
    }

    match /users/{userId} {
      allow create: if signedIn() && userId == request.auth.uid && request.resource.data.role in ['patient', 'doctor'];
      allow read: if signedIn() && (userId == request.auth.uid || resource.data.role == 'doctor' || (isDoctor() && resource.data.doctorId == request.auth.uid));
      allow update: if signedIn() && userId == request.auth.uid && request.resource.data.role == resource.data.role;
    }

    match /deletionRequests/{requestId} {
      allow create: if signedIn() && requestId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /alerts/{alertId} {
      allow create: if signedIn() && request.resource.data.patientId == request.auth.uid
        && request.resource.data.doctorId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.doctorId;
      allow read: if signedIn() && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid);
      allow update: if isDoctor() && resource.data.doctorId == request.auth.uid;
    }

    match /analysisResults/{resultId} {
      allow create: if signedIn() && request.resource.data.patientId == request.auth.uid
        && request.resource.data.doctorId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.doctorId;
      allow read: if signedIn() && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid);
    }
  }
}

