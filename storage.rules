rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /alert-images/{patientId}/{imageName} {
      allow write: if request.auth != null && request.auth.uid == patientId;
      allow read: if request.auth != null && request.auth.uid == patientId;
    }
    match /sample-history/{patientId}/{imageName} {
      allow write, read: if request.auth != null && request.auth.uid == patientId;
    }
  }
}
