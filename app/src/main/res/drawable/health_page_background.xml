<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#F8FBFF" android:centerColor="#F3F7FB" android:endColor="#EDF4FB" />
        </shape>
    </item>
    <item android:gravity="top|left" android:width="280dp" android:height="280dp" android:left="-100dp" android:top="-90dp">
        <shape android:shape="oval"><solid android:color="#1F0F6FFF" /></shape>
    </item>
    <item android:gravity="top|right" android:width="240dp" android:height="240dp" android:right="-85dp" android:top="-70dp">
        <shape android:shape="oval"><solid android:color="#2000A991" /></shape>
    </item>
</layer-list>
