<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/health_page_background" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
   <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:onClick="goBack" android:text="Back" android:textAllCaps="false" />
   <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
   <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:onClick="openDoctorSettings" android:text="Profile" android:textAllCaps="false" />
  </LinearLayout>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/app_surface" app:cardCornerRadius="28dp" app:cardElevation="3dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="26dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DOCTOR PORTAL" android:textColor="@color/brand_primary" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Good morning, Doctor" android:textColor="@color/app_on_surface" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="A clear view of your patients and urgent clinical updates." android:textColor="@color/app_on_surface_variant" android:textSize="15sp" />
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/health_hero_gradient" android:orientation="vertical" android:padding="24dp">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOUR DOCTOR ID" android:textColor="#DDEBFF" android:textSize="12sp" android:textStyle="bold" />
   <TextView android:id="@+id/doctor_app_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/brand_on_primary" android:textIsSelectable="true" android:textSize="15sp" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Share this ID with patients who need to connect with you." android:textColor="#EAF2FF" android:textSize="14sp" />
   <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginTop="12dp" android:onClick="openDoctorQr" android:text="Show connection QR" android:textAllCaps="false" />
  </LinearLayout>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="At a glance" android:textColor="@color/app_on_surface" android:textSize="21sp" android:textStyle="bold" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
   <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="170dp" android:layout_marginEnd="8dp" android:layout_weight="1" app:cardBackgroundColor="@color/app_surface" app:cardCornerRadius="24dp" app:cardElevation="2dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Patients" android:textColor="@color/app_on_surface_variant" android:textSize="15sp"/><TextView android:id="@+id/patient_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="0 connected patients" android:textColor="@color/app_on_surface" android:textSize="19sp" android:textStyle="bold"/><com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginTop="8dp" android:onClick="openPatients" android:text="View" android:textAllCaps="false" /></LinearLayout></com.google.android.material.card.MaterialCardView>
   <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="170dp" android:layout_marginStart="8dp" android:layout_weight="1" app:cardBackgroundColor="@color/app_surface" app:cardCornerRadius="24dp" app:cardElevation="2dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Urgent alerts" android:textColor="@color/health_urgent" android:textSize="15sp"/><TextView android:id="@+id/alert_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="0 alerts" android:textColor="@color/app_on_surface" android:textSize="19sp" android:textStyle="bold"/><com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginTop="8dp" android:onClick="openAlerts" android:text="Review" android:textAllCaps="false" /></LinearLayout></com.google.android.material.card.MaterialCardView>
  </LinearLayout>
  <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:onClick="signOut" android:text="Sign out" android:textAllCaps="false" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:gravity="center" android:orientation="horizontal"><com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Dashboard"/><com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:onClick="openPatients" android:text="Patients"/><com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:onClick="openAlerts" android:text="Alerts"/><com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:onClick="openDoctorSettings" android:text="Profile"/></LinearLayout><com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/doctor_bottom_nav" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp" app:menu="@menu/doctor_bottom_nav" /></LinearLayout>
</ScrollView>