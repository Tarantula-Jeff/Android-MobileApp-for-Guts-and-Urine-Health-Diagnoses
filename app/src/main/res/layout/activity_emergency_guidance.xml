<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/health_page_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Emergency guidance" android:textColor="@color/app_on_surface" android:textSize="30sp" android:textStyle="bold" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardBackgroundColor="@color/health_urgent" app:cardCornerRadius="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="This app is not emergency care" android:textColor="@android:color/white" android:textSize="21sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="If you think someone may be seriously unwell, seek urgent professional help now. Do not wait for an analysis result, chatbot response, or doctor alert reply." android:textColor="@android:color/white" android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Get emergency help now for signs such as" android:textColor="@color/app_on_surface" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="• Severe trouble breathing, blue or grey lips, or inability to speak normally\n\n• Severe chest pain, collapse, fainting, seizure, or loss of consciousness\n\n• Severe or ongoing bleeding, including vomiting blood or black/tarry stool with weakness, dizziness, or fainting\n\n• Sudden confusion, severe weakness, or a rapidly worsening condition\n\n• Any situation where you believe there is an immediate danger to life" android:textColor="@color/app_on_surface_variant" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="In Ghana, 112 connects to emergency services. Elsewhere, call your local emergency number or go to the nearest emergency facility." android:textColor="@color/app_on_surface" android:textSize="15sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/call_emergency" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="Call 112 emergency services" android:textAllCaps="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="If it is safe, ask someone to stay with the person and take them to urgent care. This page provides general safety guidance only and cannot assess your condition." android:textColor="@color/app_on_surface_variant" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
