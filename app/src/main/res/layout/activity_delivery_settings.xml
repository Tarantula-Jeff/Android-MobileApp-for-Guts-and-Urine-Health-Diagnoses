<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/health_page_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" android:textColor="@color/app_on_surface" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Manage your doctor connection and urgent alert preferences." android:textColor="@color/app_on_surface_variant" android:textSize="16sp" />
        <com.google.android.material.textfield.TextInputLayout app:boxBackgroundMode="outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:hint="Doctor's app ID">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/settings_doctor_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/scan_doctor_qr" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Scan doctor QR" android:textAllCaps="false" app:cornerRadius="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/find_doctor" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Find a doctor" android:textAllCaps="false" app:cornerRadius="16dp" />
        <TextView android:id="@+id/selected_doctor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Search by doctor name, email address, or app ID." android:textColor="@color/app_on_surface_variant" android:textSize="13sp" />
        <com.google.android.material.textfield.TextInputLayout app:boxBackgroundMode="outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="Doctor's phone number">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/settings_doctor_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Urgent alert delivery" android:textColor="@color/app_on_surface" android:textSize="18sp" android:textStyle="bold" />
        <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
            <RadioButton android:id="@+id/delivery_app" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Secure in-app alert (recommended)" />
            <RadioButton android:id="@+id/delivery_sms" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="SMS text message" />
        </RadioGroup>
        <Switch android:id="@+id/include_picture" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Image sharing is unavailable while cloud photo storage is off" android:enabled="false" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Personal preferences" android:textColor="@color/app_on_surface" android:textSize="18sp" android:textStyle="bold" />
        <com.google.android.material.textfield.TextInputLayout app:boxBackgroundMode="outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Display name"><com.google.android.material.textfield.TextInputEditText android:id="@+id/settings_display_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" /></com.google.android.material.textfield.TextInputLayout>
        <Switch android:id="@+id/settings_urgent_notifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Urgent alert notifications" />
        <Switch android:id="@+id/settings_share_consent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Allow text results to be shared with my doctor" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Default analysis" android:textColor="@color/app_on_surface" android:textSize="16sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/default_analysis_group" android:layout_width="match_parent" android:layout_height="wrap_content"><RadioButton android:id="@+id/default_stool" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stool" /><RadioButton android:id="@+id/default_urine" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Urine" /></RadioGroup><com.google.android.material.button.MaterialButton android:id="@+id/disconnect_doctor" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Disconnect doctor" android:textAllCaps="false" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Data controls" android:textColor="@color/app_on_surface" android:textSize="18sp" android:textStyle="bold" /><com.google.android.material.button.MaterialButton android:id="@+id/clear_local_history" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Clear local sample history" android:textAllCaps="false" />        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Account and privacy" android:textColor="@color/app_on_surface" android:textSize="18sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/request_data_deletion" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Request account or data deletion" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/save_delivery_settings" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="28dp" android:text="Save preferences" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>