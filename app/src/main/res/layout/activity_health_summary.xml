<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/health_page_background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Weekly health summary" android:textColor="@color/app_on_surface" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Your last seven days of analyses, symptoms, and urgent alerts. Review before sharing." android:textColor="@color/app_on_surface_variant" android:textSize="15sp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="18dp" android:layout_weight="1">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/app_surface">
            <TextView android:id="@+id/summary_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:textColor="@color/app_on_surface" android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/export_summary_pdf" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:text="Export as PDF" android:textAllCaps="false" />
    <com.google.android.material.button.MaterialButton android:id="@+id/share_summary" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:text="Share weekly summary" android:textAllCaps="false" />
</LinearLayout>
