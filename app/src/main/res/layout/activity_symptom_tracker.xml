<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/health_page_background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Symptom tracker"
        android:textColor="@color/app_on_surface"
        android:textSize="30sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Keep a private daily record. These entries stay on this device."
        android:textColor="@color/app_on_surface_variant"
        android:textSize="15sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/app_surface"
        android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Symptom, e.g. stomach pain">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/symptom_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Severity" android:textColor="@color/app_on_surface" android:textStyle="bold" />
            <RadioGroup android:id="@+id/severity_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <RadioButton android:id="@+id/severity_mild" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Mild" />
                <RadioButton android:id="@+id/severity_moderate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Moderate" />
                <RadioButton android:id="@+id/severity_severe" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Severe" />
            </RadioGroup>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Notes (optional)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/symptom_notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:inputType="textMultiLine" android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/save_symptom" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:text="Save symptom" android:textAllCaps="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Recent entries" android:textColor="@color/app_on_surface" android:textSize="20sp" android:textStyle="bold" />
    <ListView android:id="@+id/symptom_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="10dp" android:layout_weight="1" android:background="@android:color/transparent" android:divider="@android:color/transparent" android:dividerHeight="0dp" />
</LinearLayout>
